# ==================================================
# NIRNAY PLATFORM - ENVIRONMENT CONFIGURATION CONTRACT
# ==================================================

# --------------------------------------------------
# BACKEND API (apps/api)
# --------------------------------------------------
APP_NAME=nirnay-api
APP_ENV=development
DEBUG=true

# Database connection URL (PostgreSQL with psycopg3 driver)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/nirnay

# Demo Mode toggle (MUST BE false IN PRODUCTION)
DEMO_MODE=true

# Allowed CORS origins (comma-separated, NO wildcards in staging/production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------------------------------------------------
# FRONTEND WEB APPLICATION (apps/web)
# --------------------------------------------------
# Base URL for backend REST API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Canonical Golden Demo Reviewer Actor UUID
NEXT_PUBLIC_DEMO_REVIEWER_ACTOR_ID=d99c55a9-e4d4-42c1-abd1-5e9ccb2ad67c

# Emergency Offline Fallback Mode (MUST BE false FOR NORMAL & HOSTED DEMO)
# Set to 'true' ONLY if backend/database is completely unreachable during venue emergency.
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK=false
